{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lenso-marketplace-recovery-proof",
  "main": "../worker.mjs",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "enable_request_signal"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 1000
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CATALOG_ID": "workers-g3-proof",
    "CATALOG_KEY_ID": "test-key",
    "CATALOG_PUBLIC_KEY": "d04ab232742bb4ab3a1368bd4615e4e6d0224ab71a016baf8520a332c9778737",
    "PROOF_DIAGNOSTICS": "1"
  },
  "d1_databases": [
    {
      "binding": "MARKETPLACE_DB",
      "database_name": "lenso-marketplace-recovery-proof",
      "database_id": "256d0844-cff5-4ead-8770-ab62c7f181d1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MARKETPLACE_OBJECTS",
      "bucket_name": "lenso-marketplace-recovery-proof"
    }
  ]
}
